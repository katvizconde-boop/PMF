generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  mustChangePassword Boolean @default(false)
  failedLoginCount Int      @default(0)
  lockedUntil    DateTime?
  firstName      String
  middleName     String?
  lastName       String
  position       String?
  role           String       // HR_ADMIN | MANAGER | EMPLOYEE
  employmentType String       // REGULAR | PROBATIONARY | CONTRACTUAL
  company        String?      // M2.0 Communications | Media Meter Inc. | Rythmos DB
  department     String?
  phone          String?
  address        String?
  emergencyContact String?
  profilePicture String?      // base64 data URL
  hireDate       DateTime?
  onboardingCompleted Boolean @default(false)
  managerId      String?
  manager        User?        @relation("Reports", fields: [managerId], references: [id])
  reports        User[]       @relation("Reports")
  // ── Co-managers (RythmosDB-style team setup) ──
  // An employee can have additional managers who can also view + edit their PMF.
  // The primary `manager` (above) still owns the relationship for HR purposes;
  // co-managers are collaborators with equal access during MANAGER_REVIEW.
  coManagerOf    CoManager[]  @relation("CoManagedEmployee")  // I am the employee — who else manages me
  asCoManager    CoManager[]  @relation("CoManagerUser")      // I am a co-manager — whose teams am I on
  assignmentsAsEmployee Assignment[] @relation("EmpAssignments")
  assignmentsAsManager  Assignment[] @relation("MgrAssignments")
  goals          Goal[]       @relation("UserGoals")
  auditLogs      AuditLog[]
  notifications  Notification[] @relation("UserNotifications")
  kudosSent      Kudos[]      @relation("KudosSent")
  kudosReceived  Kudos[]      @relation("KudosReceived")
  oneOnOnesAsEmployee OneOnOne[] @relation("OneOnOneEmployee")
  oneOnOnesAsManager  OneOnOne[] @relation("OneOnOneManager")
  pipsAsEmployee PIP[]        @relation("PIPEmployee")
  pipsAsManager  PIP[]        @relation("PIPManager")
  documents      Document[]   @relation("UserDocuments")
  careerProgress UserCareerProgress? @relation("UserCareerProgress")
  createdAt      DateTime     @default(now())
}

model Template {
  id         String    @id @default(cuid())
  name       String
  type       String    // REGULAR | PROBATIONARY
  isActive   Boolean   @default(true)
  sections   Section[]
  assignments Assignment[]
  createdAt  DateTime  @default(now())
}

model Section {
  id         String     @id @default(cuid())
  templateId String
  template   Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  kind       String     // KPI | COMPETENCY | COMMENT | RECOMMENDATION
  weight     Float      @default(0)
  sortOrder  Int        @default(0)
  questions  Question[]
}

model Question {
  id        String     @id @default(cuid())
  sectionId String
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  prompt    String
  description String?  // shown beneath the prompt as guidance
  inputType String     // rating | text | select
  options   String?    // JSON
  required  Boolean    @default(true)
  weight    Float      @default(1)
  sortOrder Int        @default(0)
  responses Response[]
}

model Cycle {
  id                    String       @id @default(cuid())
  name                  String
  periodStart           DateTime
  periodEnd             DateTime
  dueDate               DateTime
  autoAssignRegular     Boolean      @default(false)
  autoAssignProbationary Boolean     @default(false)
  regularTemplateId     String?
  probationaryTemplateId String?
  assignments           Assignment[]
  goals                 Goal[]
  createdAt             DateTime     @default(now())
}

model Department {
  id        String   @id @default(cuid())
  company   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([company, name])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserGoals", fields: [userId], references: [id], onDelete: Cascade)
  cycleId     String
  cycle       Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  description String
  target      String?  // measurable target (optional)
  status      String   @default("ACTIVE") // DRAFT | ACTIVE | ACHIEVED | PARTIALLY_ACHIEVED | MISSED | DEFERRED
  rating      Float?
  evidence    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, cycleId])
}

model Assignment {
  id                   String     @id @default(cuid())
  cycleId              String
  cycle                Cycle      @relation(fields: [cycleId], references: [id])
  templateId           String
  template             Template   @relation(fields: [templateId], references: [id])
  employeeId           String
  employee             User       @relation("EmpAssignments", fields: [employeeId], references: [id])
  managerId            String
  manager              User       @relation("MgrAssignments", fields: [managerId], references: [id])
  state                String     @default("SELF_ASSESS") // SELF_ASSESS | MANAGER_REVIEW | HR_REVIEW | FINALIZED
  overallScore         Float?
  recommendation       String?
  // ── Private (confidential) manager recommendation ──
  // Visible ONLY to the manager who created it and HR_ADMIN. Never sent to the employee.
  // Used for sensitive recommendations like salary increase, PIP, role change that may not be approved.
  privateRecommendation       String?    // NO_ACTION | SALARY_INCREASE | PROMOTION | LATERAL_MOVE | PIP | TERMINATION_REVIEW | OTHER
  privateRecommendationNotes  String?    // Free-form justification, max 5000 chars (enforced at API)
  // ── Key Projects & Activities (Part I of the PMF) ──
  // JSON array of rows: [{ keyResponsibility, activitiesProjects, remarks }]
  // Editable by EMPLOYEE during SELF_ASSESS; read-only for MANAGER + HR after that.
  keyProjectActivities        String?    // JSON-encoded array
  selfSubmittedAt      DateTime?
  managerSubmittedAt   DateTime?
  hrApprovedAt         DateTime?
  finalizedAt          DateTime?
  responses            Response[]
  lastReminderAt       DateTime?
  employeeSignature    String?    // base64 data URL
  managerSignature     String?
  hrSignature          String?
  employeeSignatureName String?   // manually typed by signer at sign time
  managerSignatureName  String?
  hrSignatureName       String?
  employeeSignedAt     DateTime?
  managerSignedAt      DateTime?
  hrSignedAt           DateTime?
  createdAt            DateTime   @default(now())

  @@unique([cycleId, employeeId])
}

model Response {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  authorRole   String     // EMPLOYEE | MANAGER | HR
  rating       Float?
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, questionId, authorRole])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String   // PMF_ASSIGNED | PMF_DUE | PMF_FINALIZED | KUDOS | ONEONONE | PIP | INFO
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Kudos {
  id          String   @id @default(cuid())
  fromUserId  String
  fromUser    User     @relation("KudosSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User     @relation("KudosReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  message     String
  category    String?  // Collaboration | Excellence | Innovation | Integrity | Learning | Customer-First
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([toUserId])
  @@index([fromUserId])
}

model OneOnOne {
  id          String   @id @default(cuid())
  employeeId  String
  employee    User     @relation("OneOnOneEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId   String
  manager     User     @relation("OneOnOneManager", fields: [managerId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  agenda      String?
  notes       String?
  actionItems String?
  completedAt DateTime?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, scheduledAt])
  @@index([managerId, scheduledAt])
}

model PIP {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("PIPEmployee", fields: [userId], references: [id], onDelete: Cascade)
  managerId   String
  manager     User     @relation("PIPManager", fields: [managerId], references: [id])
  startDate   DateTime
  endDate     DateTime
  status      String   @default("ACTIVE") // ACTIVE | SUCCESSFUL | UNSUCCESSFUL | EXTENDED | CANCELLED
  reason      String
  goals       String   // newline-separated milestones
  checkIns    String?  // JSON array of {date, note, status}
  outcome     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([managerId])
}

model CareerPath {
  id          String @id @default(cuid())
  name        String
  company     String?
  description String?
  steps       CareerPathStep[]
  progress    UserCareerProgress[] @relation("CurrentPath")
  createdAt   DateTime @default(now())
}

model CareerPathStep {
  id              String @id @default(cuid())
  careerPathId    String
  careerPath      CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  title           String
  level           Int                 // ladder position (1, 2, 3...)
  yearsTypical    String?             // "0-2 years"
  skills          String              // newline-separated competencies/skills required
  responsibilities String?
  sortOrder       Int @default(0)
  currentOf       UserCareerProgress[] @relation("CurrentStep")
  targetOf        UserCareerProgress[] @relation("TargetStep")
}

model UserCareerProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation("UserCareerProgress", fields: [userId], references: [id], onDelete: Cascade)
  currentPathId String?
  currentPath   CareerPath? @relation("CurrentPath", fields: [currentPathId], references: [id])
  currentStepId String?
  currentStep   CareerPathStep? @relation("CurrentStep", fields: [currentStepId], references: [id])
  targetStepId  String?
  targetStep    CareerPathStep? @relation("TargetStep", fields: [targetStepId], references: [id])
  notes         String?
  updatedAt     DateTime @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  type         String   // CONTRACT | CERTIFICATE | MEMO | ID | RESUME | OTHER
  name         String
  fileData     String   // base64 data URL
  mimeType     String
  size         Int
  uploadedById String
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId, type])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  detail       String?
  createdAt    DateTime @default(now())
}

// ── Co-Manager (multi-manager) relationship ──
// Allows multiple managers to share access to one employee's PMF.
// Used for RythmosDB-style teams where 2-3 managers collaborate on evaluations.
// Primary manager is still on User.managerId — this table adds additional collaborators.
model CoManager {
  id          String   @id @default(cuid())
  employeeId  String
  managerId   String
  notes       String?  // Optional: HR's note about the arrangement
  createdAt   DateTime @default(now())

  employee    User     @relation("CoManagedEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager     User     @relation("CoManagerUser",     fields: [managerId],  references: [id], onDelete: Cascade)

  @@unique([employeeId, managerId])
  @@index([managerId])
}
